# AI and TTS credentials
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=

# Required for Qiniu Kodo upload
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=

# Defaults match the updater URL in this repository
QINIU_CDN_BASE_URL=https://qny.luckyblank.cn
QINIU_KEY_PREFIX=live2d-pet

# Optional upload and refresh settings
QINIU_REGION=auto
QINIU_UPLOAD_ACCELERATE=false
QINIU_UPLOAD_TOKEN_TTL_SECONDS=7200
QINIU_RESUME_THRESHOLD_MB=4
QINIU_REFRESH_CACHE=true
QINIU_HTTP_TIMEOUT_MS=30000

# Optional path overrides, relative to the project root
RELEASE_DIST_DIR=dist
RELEASE_NOTES_DIR=release
