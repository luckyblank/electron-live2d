{
  "name": "electron-live2d-pet",
  "productName": "Live2D 桌面伙伴",
  "version": "1.0.0",
  "description": "Live2D 桌面 Q 版宠物",
  "main": "main.js",
  "scripts": {
    "start": "nodemon --exec electron .",
    "dev": "nodemon --exec \"electron . --dev\"",
    "check": "node --check main.js && node --check preload.js && node --check settings-preload.js && node --check renderer/app.js && node --check renderer/settings.js",
    "lint": "eslint .",
    "package:win": "npm run check && electron-builder --win"
  },
  "build": {
    "appId": "com.luckyblank.live2d",
    "files": [
      "**/*",
      "!plan/**",
      "!**/*.{bak,md}",
      "!test-electron.js",
      "!download-models.cjs",
      "!resources/generate-icon.js",
      "!renderer/diagnose_tmp.txt",
      "!dist/**",
      "!out/**",
      "!nodemon.json",
      "!electron-builder.yml",
      "!.eslintrc.json"
    ],
    "win": {
      "icon": "./resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.10",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "live2d-renderer": "^0.6.6"
  }
}
